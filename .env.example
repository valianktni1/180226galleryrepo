# ============================================
# WEDDINGS BY MARK - Environment Variables
# ============================================
# Copy this file to .env and update the values

# Generate a secure JWT secret (run this command):
# openssl rand -hex 32
JWT_SECRET=your-secure-random-secret-here

# Your TrueNAS IP or domain (used for building frontend)
# For local testing: http://192.168.x.x:3037
# For production: https://weddingsbymark.uk
SERVER_URL=http://YOUR_TRUENAS_IP:3037
